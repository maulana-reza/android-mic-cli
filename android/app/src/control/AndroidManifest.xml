<?xml version="1.0" encoding="utf-8"?>
<!-- The control flavor only. Play Protect blocks installing apps with an accessibility service from a
     browser, chat app or file manager, so the standard flavor goes without and installs like any app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".ControlService"
            android:exported="true"
            android:label="Mirror control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>
    </application>
</manifest>
