<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Platform Material, no AndroidX. values-night swaps the parent for the dark one. -->
    <style name="MirrorBase" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Mirror" parent="MirrorBase">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <!-- Before Android 15 the system bars have their own colour: the page's. -->
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
    </style>
</resources>
